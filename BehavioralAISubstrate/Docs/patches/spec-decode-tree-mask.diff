+// --- BAS tree-spec patch (Docs/patches/spec-decode-tree-mask.diff) ----------------------------------------------
+// Verify a flattened draft TREE in one forward: a custom attention mask (each node attends only its ancestors) +
+// per-depth RoPE (the fast kernel has no per-token position, so each depth level — a contiguous flat slice by
+// the depth-major flatten — gets ONE scalar offset). `tree == nil` everywhere → the ORIGINAL causal path,
+// bit-for-bit (byte-identity of the deterministic spine is preserved by construction).
+public struct LlamaTreeForward {
+    public let mask: MLXFast.ScaledDotProductAttentionMaskMode
+    public let ropeSegments: [(range: Range<Int>, depth: Int)]
+    public init(mask: MLXFast.ScaledDotProductAttentionMaskMode,
+                ropeSegments: [(range: Range<Int>, depth: Int)]) {
+        self.mask = mask
+        self.ropeSegments = ropeSegments
+    }
+}
+
+/// Apply RoPE per depth-segment with a scalar offset `base + depth` (base = the cache offset = the seed's
+/// position). x is [B, heads, L, dim]; segments partition the L axis into contiguous equal-depth ranges.
+func applyTreeRoPE(
+    _ rope: RoPELayer, to x: MLXArray, segments: [(range: Range<Int>, depth: Int)], base: Int
+) -> MLXArray {
+    var parts: [MLXArray] = []
+    parts.reserveCapacity(segments.count)
+    for seg in segments {
+        parts.append(rope(x[0..., 0..., seg.range, 0...], offset: base + seg.depth))
+    }
+    return concatenated(parts, axis: 2)
+}
+// --- end BAS tree-spec patch ------------------------------------------------------------------------------------
